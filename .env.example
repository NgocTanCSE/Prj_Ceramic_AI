# CERAMIC CRAFT-TECH MVP ENVIRONMENT CONFIGURATION (SAMPLE)
NODE_ENV=development
APP_NAME=GomViet_DesignStudio

PORT_FE=3000
PORT_BE=5000
PORT_API=8000
# BE server port (used by BE/server.js process.env.PORT)
PORT=5000

VITE_API_BASE_URL=http://localhost:5000
VITE_AI_API_BASE_URL=http://localhost:8000
FE_ORIGIN=http://localhost:3000

# AI Configuration (Optional: built-in rule engine will work if no keys)
# Primary: Cloudflare Workers AI (LLaMA) — code-ready, paste token after deploy
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct-fp8
CLOUDFLARE_VISION_MODEL=@cf/meta/llama-3.2-11b-vision-instruct
# HF_TOKEN for HuggingFace Spaces (FLUX.1 text-to-image, SF3D image-to-3d)

# HuggingFace Spaces integration (Text→2D FLUX, 2D→3D SF3D).
# HF_TOKEN is OPTIONAL — public spaces (FLUX.1-schnell, stable-fast-3d) run unauthenticated,
# but a token bypasses queue / unlocks gated spaces. KEEP THIS A REAL SECRET (do NOT commit a real value).
HF_TOKEN=
HF_FLUX_SPACE=black-forest-labs/FLUX.1-schnell
HF_FLUX_FN=/infer
HF_SF3D_SPACE=stabilityai/stable-fast-3d
HF_SF3D_FN=/run_button
# GRADIO_MOCK=1 → use deterministic mock client (test pipeline structure without HF/token)
GRADIO_MOCK=

# Ceramic Village Studio Info
STUDIO_LOCATION=Làng Gốm Bát Tràng, Gia Lâm, Hà Nội
WORKSHOP_SLOTS=["09:00 - 11:30 (Sáng - Ca 1)", "14:00 - 16:30 (Chiều - Ca 2)", "17:00 - 19:30 (Hoàng hôn - Ca 3)"]

# Visit appointment slots (for BE visitor scheduling)
VISIT_SLOTS=["09:00 - 11:30 (Sáng)", "10:30 - 12:30 (Trưa)", "14:00 - 16:00 (Chiều)", "16:00 - 18:00 (Hoàng hôm)"]
